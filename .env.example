# Copy to .env and fill in. Never commit .env.

# Detection
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Processing
# Highlight selection. With `selector: claude_cli` (config/creators.yaml) it runs on your
# Claude subscription: create a long-lived token with `claude setup-token`. Locally an
# existing `claude` login also works and the token can stay empty.
CLAUDE_CODE_OAUTH_TOKEN=
# Only with `selector: api` (paid Messages API, billed per token).
ANTHROPIC_API_KEY=
# Optional: only needed with `transcriber: groq` (default is local faster-whisper).
GROQ_API_KEY=

# Notifications / health
DISCORD_WEBHOOK_URL=
DISCORD_ALERTS_WEBHOOK_URL=
HEALTHCHECK_URL_MONITOR=
HEALTHCHECK_URL_WORKER=

# Review app
# bcrypt hash; keep the single quotes so Compose does not interpolate '$': REVIEW_PASSWORD_HASH='$2b$12$...'
REVIEW_PASSWORD_HASH=
SESSION_SECRET=

# Optional: export sync to Drive via rclone remote name, e.g. "gdrive:clips"
RCLONE_REMOTE=

# Posting accounts (config/accounts.yaml, CLP-91): one set per account id, upper-cased,
# as CLIPPER_<KIND>_<ACCOUNT_ID>. Uncomment and fill in when the account is connected.
# CLIPPER_ACCESS_TOKEN_MRBEAST_CLIPS_TT=
# CLIPPER_REFRESH_TOKEN_MRBEAST_CLIPS_TT=
# CLIPPER_ACCESS_TOKEN_MRBEAST_CLIPS_YT=
# CLIPPER_REFRESH_TOKEN_MRBEAST_CLIPS_YT=
# CLIPPER_ACCESS_TOKEN_MRBEAST_CLIPS_IG=
# CLIPPER_REFRESH_TOKEN_MRBEAST_CLIPS_IG=
# CLIPPER_ACCESS_TOKEN_MRBEAST_CLIPS_FB=
# CLIPPER_REFRESH_TOKEN_MRBEAST_CLIPS_FB=
