# Copy to .env and fill in. Never commit .env.

# Detection
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Processing
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Notifications / health
DISCORD_WEBHOOK_URL=
DISCORD_ALERTS_WEBHOOK_URL=
HEALTHCHECK_URL_MONITOR=
HEALTHCHECK_URL_WORKER=

# Review app
# bcrypt hash; keep the single quotes so Compose does not interpolate '$': REVIEW_PASSWORD_HASH='$2b$12$...'
REVIEW_PASSWORD_HASH=
SESSION_SECRET=

# Optional: export sync to Drive via rclone remote name, e.g. "gdrive:clips"
RCLONE_REMOTE=
