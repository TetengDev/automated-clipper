{
  "$defs": {
    "CaptionStyle": {
      "enum": [
        "bold_pop"
      ],
      "title": "CaptionStyle",
      "type": "string"
    },
    "CropKey": {
      "additionalProperties": false,
      "description": "Where the 9:16 crop window is centred at `t_s` (seconds from the clip start), as a\nshare of the source width. Keys are linear in between; two keys at one time are a jump\n(a scene cut).",
      "properties": {
        "t_s": {
          "description": "Seconds from the clip start.",
          "minimum": 0,
          "title": "T S",
          "type": "number"
        },
        "x_center": {
          "description": "Crop centre, share of the source width.",
          "maximum": 1,
          "minimum": 0,
          "title": "X Center",
          "type": "number"
        }
      },
      "required": [
        "t_s",
        "x_center"
      ],
      "title": "CropKey",
      "type": "object"
    },
    "Cut": {
      "additionalProperties": false,
      "description": "A range cut out of the clip (`applied`) or only proposed, seconds in the source.",
      "properties": {
        "applied": {
          "title": "Applied",
          "type": "boolean"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "in_s": {
          "minimum": 0,
          "title": "In S",
          "type": "number"
        },
        "kind": {
          "$ref": "#/$defs/CutKind"
        },
        "out_s": {
          "exclusiveMinimum": 0,
          "title": "Out S",
          "type": "number"
        },
        "reason": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "in_s",
        "out_s",
        "kind",
        "confidence",
        "reason",
        "applied"
      ],
      "title": "Cut",
      "type": "object"
    },
    "CutKind": {
      "enum": [
        "silence",
        "stutter",
        "retake",
        "false_start",
        "filler"
      ],
      "title": "CutKind",
      "type": "string"
    },
    "Hook": {
      "additionalProperties": false,
      "properties": {
        "ai_generated": {
          "description": "Synthetic voice or text (CLP-96 disclosure).",
          "title": "Ai Generated",
          "type": "boolean"
        },
        "duration_s": {
          "default": 2.0,
          "description": "Seconds from clip start.",
          "maximum": 3.0,
          "minimum": 1.0,
          "title": "Duration S",
          "type": "number"
        },
        "style": {
          "$ref": "#/$defs/HookStyle",
          "default": "stakes"
        },
        "text": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Hook",
      "type": "object"
    },
    "HookStyle": {
      "enum": [
        "stakes",
        "question",
        "quote"
      ],
      "title": "HookStyle",
      "type": "string"
    },
    "Layout": {
      "description": "Frame layout: the source fit over a blurred copy, or a 9:16 crop following faces.",
      "enum": [
        "blurred_fill",
        "face_track"
      ],
      "title": "Layout",
      "type": "string"
    },
    "Segment": {
      "additionalProperties": false,
      "description": "A kept range of the clip, seconds in the source.",
      "properties": {
        "ai_generated": {
          "description": "Generated footage, e.g. b-roll (CLP-96).",
          "title": "Ai Generated",
          "type": "boolean"
        },
        "in_s": {
          "minimum": 0,
          "title": "In S",
          "type": "number"
        },
        "out_s": {
          "exclusiveMinimum": 0,
          "title": "Out S",
          "type": "number"
        }
      },
      "required": [
        "in_s",
        "out_s"
      ],
      "title": "Segment",
      "type": "object"
    },
    "SourceSegment": {
      "additionalProperties": false,
      "properties": {
        "in_s": {
          "description": "Cut start, seconds in the source.",
          "minimum": 0,
          "title": "In S",
          "type": "number"
        },
        "out_s": {
          "description": "Cut end, seconds in the source.",
          "exclusiveMinimum": 0,
          "title": "Out S",
          "type": "number"
        },
        "path": {
          "description": "Source media path relative to the media root (POSIX separators).",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-/ ]{0,511}$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "in_s",
        "out_s"
      ],
      "title": "SourceSegment",
      "type": "object"
    },
    "Word": {
      "additionalProperties": false,
      "properties": {
        "end_s": {
          "description": "Seconds in the source timeline.",
          "minimum": 0,
          "title": "End S",
          "type": "number"
        },
        "start_s": {
          "description": "Seconds in the source timeline.",
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "text": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "start_s",
        "end_s"
      ],
      "title": "Word",
      "type": "object"
    }
  },
  "$id": "https://clipper.local/schema/edl.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Composition props for the Remotion `Clip` composition (1080x1920 @ 30 fps).",
  "properties": {
    "caption_style": {
      "$ref": "#/$defs/CaptionStyle",
      "default": "bold_pop"
    },
    "captions_enabled": {
      "default": true,
      "title": "Captions Enabled",
      "type": "boolean"
    },
    "crop": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/CropKey"
          },
          "maxItems": 2000,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Crop"
    },
    "cuts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Cut"
      },
      "maxItems": 1000,
      "title": "Cuts",
      "type": "array"
    },
    "hook": {
      "anyOf": [
        {
          "$ref": "#/$defs/Hook"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "layout": {
      "$ref": "#/$defs/Layout",
      "default": "blurred_fill"
    },
    "progress_bar": {
      "default": true,
      "title": "Progress Bar",
      "type": "boolean"
    },
    "schema_version": {
      "default": 2,
      "enum": [
        1,
        2
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "segments": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "maxItems": 600,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Segments"
    },
    "source": {
      "$ref": "#/$defs/SourceSegment"
    },
    "words": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Word"
      },
      "maxItems": 5000,
      "title": "Words",
      "type": "array"
    }
  },
  "required": [
    "source"
  ],
  "title": "ClipEDL",
  "type": "object"
}
